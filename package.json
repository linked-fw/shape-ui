{
  "name": "@_linked/shape-ui",
  "description": "UI driven by a shape: editors, a table over any shape's instances, a form derived from its properties, a read-only view and a relation picker — plus the read and write paths through the Linked Query DSL.",
  "author": {
    "name": "",
    "email": "",
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/shape-ui.git"
  },
  "version": "2.9.2",
  "packageManager": "npm@12.2.0",
  "type": "module",
  "linkedPackage": true,
  "main": "lib/esm/index.js",
  "types": "index.d.ts",
  "license": "ISC",
  "scripts": {
    "start": "npm exec linked dev",
    "build": "linked build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs"
  },
  "keywords": [
    "lincd",
    "linked data",
    "interoperable",
    "semantic web",
    "web3"
  ],
  "dependencies": {
    "@_linked/core": "^2.41.0",
    "@_linked/react": "^2.0.0",
    "@_linked/schema": "^1.8.0",
    "@_linked/xsd": "^1.4.1",
    "@tanstack/react-table": "^8.20.5"
  },
  "devDependencies": {
    "@_linked/cli": "^1.57.0",
    "@_linked/css": "^0.3.0",
    "@_linked/icons": "^1.0.0",
    "@_linked/primitives": "^1.8.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@jest/globals": "^30.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "framer-motion": "^13.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.4.15",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "module": "lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "default": "./lib/esm/index.js"
    },
    "./components/*": {
      "types": "./lib/esm/components/*.d.ts",
      "import": "./lib/esm/components/*.js",
      "default": "./lib/esm/components/*.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js",
      "default": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js",
      "default": "./lib/esm/*.js"
    },
    "./tokens.css": "./lib/esm/tokens.css"
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@_linked/css": "^0.3.0",
    "@_linked/icons": "^1.0.0",
    "@_linked/primitives": "^1.2.0",
    "framer-motion": ">=11",
    "react": "^18 || ^19"
  },
  "files": [
    "lib",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ]
}
